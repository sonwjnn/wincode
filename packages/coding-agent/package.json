{
  "name": "@wincode/coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "./index.ts",
  "bin": {
    "wincode": "./cli/executable.ts"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./session-host": {
      "types": "./modules/sessions/host/session-host.ts",
      "import": "./modules/sessions/host/session-host.ts"
    },
    "./session-capabilities": {
      "types": "./modules/sessions/host/session-capabilities.ts",
      "import": "./modules/sessions/host/session-capabilities.ts"
    },
    "./session-rpc": {
      "types": "./modules/sessions/host/session-rpc.ts",
      "import": "./modules/sessions/host/session-rpc.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch cli/executable.ts",
    "test": "bun ../../scripts/test-portfolio.ts default --package coding-agent",
    "test:e2e": "bun ../../scripts/test-portfolio.ts e2e --package coding-agent",
    "check-types": "tsc --noEmit",
    "db:reset-sessions": "bun run scripts/reset-session-data.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "@tanstack/react-router": "catalog:",
    "@wincode/agent-core": "workspace:*",
    "@wincode/agent-runtime-ai-sdk": "workspace:*",
    "@wincode/ai": "workspace:*",
    "@wincode/runtime-utils": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "diff": "catalog:",
    "jsonc-parser": "^3.3.1",
    "ignore": "^5.3.2",
    "oauth4webapi": "^3.8.3",
    "open": "^10.2.0",
    "react": "catalog:",
    "tree-sitter-powershell": "^0.26.4",
    "tree-sitter-wasms": "^0.1.13",
    "type-fest": "catalog:",
    "web-tree-sitter": "^0.25.10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/router-cli": "1.166.43",
    "@types/bun": "catalog:",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
