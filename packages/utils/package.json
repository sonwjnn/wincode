{
  "name": "@wincode/utils",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./guards": {
      "types": "./src/guards.ts",
      "bun": "./src/guards.ts",
      "import": "./dist/guards.js"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "bun": "./src/errors.ts",
      "import": "./dist/errors.js"
    },
    "./objects": {
      "types": "./src/objects.ts",
      "bun": "./src/objects.ts",
      "import": "./dist/objects.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/guards.ts ./src/errors.ts ./src/objects.ts --outdir ./dist --target node --format esm --packages external",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "test": "bun ../../scripts/test-portfolio.ts default --package utils"
  },
  "dependencies": {
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@wincode/config": "workspace:*",
    "typescript": "catalog:"
  }
}
