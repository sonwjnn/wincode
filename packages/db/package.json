{
  "name": "@wincode/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.cloud.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.cloud.config.ts",
    "db:push": "drizzle-kit push --config drizzle.cloud.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.cloud.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@wincode/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@wincode/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
