{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/.next",
      "!**/dist",
      "!**/.devtools",
      "!**/.nx",
      "!**/.pi",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/.svelte-kit",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/convex/_generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf",
    "formatWithErrors": false
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "info",
          "options": {
            "hooks": [
              {
                "name": "useLatest",
                "stableResult": true
              }
            ]
          }
        }
      },
      "style": {
        "noExportedImports": "error",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      },
      "suspicious": {
        "useAwait": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "complexity": {
        "noVoid": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true
    },
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["packages/coding-agent/modules/sessions/agent-session/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@opentui/core": "The Agent Session is React-free and host-agnostic (ADR-0019).",
                  "@opentui/react": "The Agent Session is React-free and host-agnostic (ADR-0019).",
                  "react": "The Agent Session is React-free and host-agnostic (ADR-0019).",
                  "react-dom": "The Agent Session is React-free and host-agnostic (ADR-0019)."
                },
                "patterns": [
                  {
                    "group": [
                      "../compaction",
                      "../compaction/index",
                      "../compaction/index.ts",
                      "../compaction/use-compaction-settings",
                      "./compaction",
                      "./compaction/index",
                      "@/modules/sessions/compaction",
                      "@/modules/sessions/compaction/index"
                    ],
                    "message": "Import the React-free leaf instead of this barrel: a barrel re-exports React-using modules, so the Agent Session is no longer host-agnostic (ADR-0019)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/coding-agent/modules/application/rpc/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/modules/sessions/storage/attachment-store": "Resolve attachment references through the Session-owned contract instead of importing blob storage.",
                  "@/modules/sessions/storage/attachment-store.ts": "Resolve attachment references through the Session-owned contract instead of importing blob storage.",
                  "../../sessions/storage/attachment-store": "Resolve attachment references through the Session-owned contract instead of importing blob storage.",
                  "../../sessions/storage/attachment-store.ts": "Resolve attachment references through the Session-owned contract instead of importing blob storage."
                }
              }
            }
          }
        }
      }
    }
  ],
  "extends": ["ultracite/biome/core", "ultracite/biome/react"]
}
