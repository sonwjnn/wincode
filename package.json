{
  "name": "wincode",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@trpc/server": "^11.16.0",
      "better-auth": "1.6.9",
      "ai": "^6.0.3",
      "next-themes": "^0.4.6",
      "@trpc/client": "^11.16.0",
      "@polar-sh/better-auth": "^1.8.3",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.91.2",
      "react": "^19.2.5",
      "@tanstack/react-query": "^5.99.0",
      "@tanstack/react-router": "^1.168.22",
      "@trpc/tanstack-react-query": "^11.16.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:cli": "turbo -F cli dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @wincode/db db:push",
    "db:studio": "turbo -F @wincode/db db:studio",
    "db:generate": "turbo -F @wincode/db db:generate",
    "db:migrate": "turbo -F @wincode/db db:migrate",
    "deploy": "turbo -F @wincode/infra deploy",
    "destroy": "turbo -F @wincode/infra destroy",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@wincode/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@cloudflare/workers-types": "^4.20251213.0",
    "@types/bun": "catalog:",
    "@wincode/config": "workspace:*",
    "lefthook": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.6.5"
  },
  "packageManager": "bun@1.2.20"
}
