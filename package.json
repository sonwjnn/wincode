{
  "name": "wincode",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "diff": "8.0.2",
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.4",
      "ai": "^6.0.3",
      "next-themes": "^0.4.6",
      "@types/react-dom": "^19.2.3",
      "@ai-sdk/react": "^3.0.3",
      "react": "^19.2.5",
      "@tanstack/react-router": "^1.168.22"
    }
  },
  "overrides": {
    "unrun": "0.2.37"
  },
  "type": "module",
  "scripts": {
    "check-types": "bun run --filter '*' check-types",
    "test": "bun test apps/cli/src packages/ai/src",
    "test:unit": "bun test apps/cli/src packages/ai/src",
    "dev:cli": "bun run --cwd apps/cli dev",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/bun": "catalog:",
    "@wincode/config": "workspace:*",
    "lefthook": "latest",
    "typescript": "catalog:",
    "ultracite": "7.6.5"
  },
  "packageManager": "bun@1.2.20",
  "patchedDependencies": {
    "@opentui/core@0.4.5": "patches/@opentui%2Fcore@0.4.5.patch"
  }
}
