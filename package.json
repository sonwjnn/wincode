{
  "name": "wincode",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "diff": "8.0.2",
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@trpc/server": "^11.16.0",
      "better-auth": "1.6.23",
      "ai": "^6.0.3",
      "next-themes": "^0.4.6",
      "@trpc/client": "^11.16.0",
      "@polar-sh/better-auth": "^1.8.3",
      "@polar-sh/sdk": "^0.47.0",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.91.2",
      "@ai-sdk/react": "^3.0.3",
      "react": "^19.2.5",
      "@tanstack/react-router": "^1.168.22"
    }
  },
  "overrides": {
    "unrun": "0.2.37"
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter './apps/*' build",
    "check-types": "bun run --filter '*' check-types",
    "test": "bun test apps/cli/src apps/server/src apps/web/src packages/ai/src packages/billing/src",
    "test:unit": "bun test apps/cli/src apps/server/src apps/web/src packages/ai/src packages/billing/src",
    "test:integration": "bun test integration.test.ts",
    "test:postgres": "bun test apps/server/tests/integration/billing/repository.postgres.test.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:cli": "bun run --cwd apps/cli dev",
    "dev:server": "bun run --cwd apps/server dev",
    "db:push": "bun run --filter @wincode/db db:push",
    "db:studio": "bun run --filter @wincode/db db:studio",
    "db:generate": "bun run --filter @wincode/db db:generate",
    "db:migrate": "bun run --filter @wincode/db db:migrate",
    "deploy": "bun run --filter @wincode/infra deploy",
    "destroy": "bun run --filter @wincode/infra destroy",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "sync:model-pricing": "bun run scripts/sync-model-pricing.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@wincode/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@cloudflare/workers-types": "^4.20251213.0",
    "@types/bun": "catalog:",
    "@wincode/config": "workspace:*",
    "lefthook": "latest",
    "typescript": "catalog:",
    "ultracite": "7.6.5"
  },
  "packageManager": "bun@1.2.20"
}
