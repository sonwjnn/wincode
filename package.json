{
  "name": "wincode",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "diff": "8.0.2",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.2",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.5",
      "@tanstack/react-router": "^1.168.22",
      "type-fest": "^5.9.0",
      "yaml": "^2.9.0"
    }
  },
  "overrides": {
    "unrun": "0.2.37"
  },
  "type": "module",
  "scripts": {
    "build:utils": "bun run --cwd packages/utils build",
    "check-types": "bun run --parallel --filter '*' check-types",
    "test": "bun --no-env-file scripts/test-portfolio.ts default",
    "test:e2e": "bun --no-env-file scripts/test-portfolio.ts e2e",
    "sync-provider-model-catalog": "bun run packages/ai/scripts/sync-provider-model-catalog.ts",
    "dev:cli": "bun run --cwd packages/coding-agent dev",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/bun": "catalog:",
    "@wincode/config": "workspace:*",
    "@wincode/utils": "workspace:*",
    "lefthook": "latest",
    "typescript": "catalog:",
    "ultracite": "7.6.5"
  },
  "packageManager": "bun@1.4.2"
}
