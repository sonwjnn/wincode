{
  "name": "wincode",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "diff": "8.0.2",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.2",
      "ai": "^6.0.3",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.5",
      "@tanstack/react-router": "^1.168.22"
    }
  },
  "overrides": {
    "unrun": "0.2.37"
  },
  "type": "module",
  "scripts": {
    "check-types": "bun run --parallel --filter '*' check-types",
    "test": "bun test --timeout 30000 --no-orphans --path-ignore-patterns '**/*.integration.test.*' packages/cli/src packages/tui packages/ai packages/skills/src packages/agent-core/src packages/agent-runtime-ai-sdk/src",
    "test:integration": "bun scripts/test-lane.ts",
    "sync-model-metadata": "bun run packages/ai/scripts/sync-model-metadata.ts",
    "dev:cli": "bun run --cwd packages/cli dev",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/bun": "catalog:",
    "@wincode/config": "workspace:*",
    "lefthook": "latest",
    "typescript": "catalog:",
    "ultracite": "7.6.5"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@opentui/core@0.4.5": "patches/@opentui%2Fcore@0.4.5.patch"
  }
}
